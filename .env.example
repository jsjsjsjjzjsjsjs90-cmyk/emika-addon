# ═══════════════════════════════════════════════════════════════════
# REQUIRED — the addon will not boot without this in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ═══════════════════════════════════════════════════════════════════
QOBUZ_ID_SECRET=replace-with-a-long-random-secret


# ═══════════════════════════════════════════════════════════════════
# IMPORTANT — controls which providers are live. Leave a source out
# to disable it cleanly (no wasted upstream calls, no hang).
# Available: qobuzdl, lastbabe, monochrome, deezer, eljohnzc, instable
# ═══════════════════════════════════════════════════════════════════
QOBUZ_ENABLED_SOURCES=qobuzdl,eljohnzc,instable


# ═══════════════════════════════════════════════════════════════════
# WORTH TUNING — per-source search timeout. Dead sources abandoned
# after this many ms instead of blocking the whole /search request.
# Keep below REQUEST_TIMEOUT_MS (6000).
# ═══════════════════════════════════════════════════════════════════
SOURCE_SEARCH_TIMEOUT_MS=3000
SOURCE_HEALTH_TIMEOUT_MS=6000  # diagnostic health checks may wait for slower providers


# ═══════════════════════════════════════════════════════════════════
# TUNING — leave at defaults unless you have a reason.
# ═══════════════════════════════════════════════════════════════════
REQUEST_TIMEOUT_MS=6000          # whole HTTP request ceiling
SERVER_REQUEST_TIMEOUT_MS=10000  # hard deadline for each public route
UPSTREAM_RETRIES=1               # retry count for retryable upstream 5xx
CACHE_TTL_SECONDS=300            # how long search results are cached
RATE_LIMIT_WINDOW_MS=60000       # rate-limit window per client
RATE_LIMIT_MAX_REQUESTS=60       # search/stream/health requests per window
RATE_LIMIT_MAX_KEYS=10000        # maximum client buckets kept in memory
MAX_QUERY_LENGTH=200              # maximum search query length
EMIKA_ALLOW_DOWNLOADS=false       # set true only when source downloads are authorized


# ═══════════════════════════════════════════════════════════════════
# DO NOT SET ON VERCEL — the platform provides these. Only needed
# if you ever run `npm run dev` locally outside Vercel.
# ═══════════════════════════════════════════════════════════════════
# HOST=0.0.0.0
# PORT=3000


# ═══════════════════════════════════════════════════════════════════
# PROVIDER SELECTION — default `multi` races enabled sources.
# Change only if you're testing a single provider.
# ═══════════════════════════════════════════════════════════════════
QOBUZ_PROVIDER=multi
# QOBUZ_PROVIDER=qobuzdl      # debug: use only Qobuz-DL
# QOBUZ_PROVIDER=http         # debug: use only the generic HTTP provider
# QOBUZ_PROVIDER=stub         # debug: return no results, contract only


# ═══════════════════════════════════════════════════════════════════
# SOURCE URLs — configured so you can flip sources back on via
# QOBUZ_ENABLED_SOURCES without changing code. Leave at defaults.
# ═══════════════════════════════════════════════════════════════════
QOBUZ_UPSTREAM_BASE_URL=https://qobuz-dll.foreyou.workers.dev
LASTBABE_BASE_URL=https://lastbabe.velixir.run
MONOCHROME_BASE_URL=https://tracks.monochrome.st
DEEZER_BASE_URL=https://bitchord-hires-addon.vercel.app
ELJOHNZC_BASE_URL=https://gglos.geisselgottes.cfd/u/eyJ2IjoxLCJzcmMiOlsicSJdLCJxIjpbIkxPU1NMRVNTIiwiSElHSCIsIkxPVyJdLCJhdG1vcyI6Im9mZiIsImhpZGUiOnsibWluU2VjIjozMH19
INSTABLE_BASE_URL=https://instable.arcod.xyz


# ═══════════════════════════════════════════════════════════════════
# INSTABLE OVERRIDES — all optional, defaults tested and working.
# Only set these if Instable changes its API and you need to patch
# without a code change.
# ═══════════════════════════════════════════════════════════════════
# INSTABLE_SEARCH_PATH=/api/search
# INSTABLE_STREAM_PATH=/api/player/stream
# INSTABLE_SOURCE=qobuz
# INSTABLE_SEND_SOURCE=false
# INSTABLE_QUALITY_LOSSLESS=27     # 27 = hi-res 24bit
# INSTABLE_QUALITY_HIGH=6          # 6  = 16bit/44.1
# INSTABLE_QUALITY_LOW=5           # 5  = mp3
# INSTABLE_API_TOKEN=
# INSTABLE_USER_AGENT=


# ═══════════════════════════════════════════════════════════════════
# GENERIC HTTP PROVIDER — only needed if QOBUZ_PROVIDER=http.
# Requires all three path/token settings to be present and real.
# ═══════════════════════════════════════════════════════════════════
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
