# HTTP server
PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=6000
UPSTREAM_RETRIES=1
CACHE_TTL_SECONDS=300
QOBUZ_ID_SECRET=replace-with-a-long-random-secret

# Provider selection. multi races LastBabe and Qobuz-DL and uses the first usable result.
QOBUZ_PROVIDER=multi
QOBUZ_UPSTREAM_BASE_URL=https://qobuz-dll.foreyou.workers.dev
LASTBABE_BASE_URL=https://lastbabe.velixir.run
MONOCHROME_BASE_URL=https://tracks.monochrome.st
DEEZER_BASE_URL=https://bitchord-hires-addon.vercel.app
ELJOHNZC_BASE_URL=https://eljohnzcaddon.velixir.run/c57e7b0ef2031b2f1fcd
INSTABLE_BASE_URL=https://instable.arcod.xyz

# ─── Instable overrides (ทั้งหมดเป็น optional) ────────────────────────
# ถ้าไม่ตั้ง จะใช้ default ในโค้ด (ทดสอบแล้วใช้ได้)
# INSTABLE_SEARCH_PATH=/api/search          # default
# INSTABLE_STREAM_PATH=/api/player/stream   # default
# INSTABLE_SOURCE=qobuz                     # default (qobuz | tidal)
# INSTABLE_SEND_SOURCE=false                # default — true ถ้าอยากส่ง ?source= ทุก path
# INSTABLE_QUALITY_LOSSLESS=27              # default (27=hi-res 24bit, 6=16/44.1, 5=mp3)
# INSTABLE_QUALITY_HIGH=6                   # default
# INSTABLE_QUALITY_LOW=5                    # default
# INSTABLE_API_TOKEN=                       # default ว่าง — Bearer token ถ้ามี
# INSTABLE_USER_AGENT=                      # default Android Chrome

# Only for an authorized, documented provider implementation.
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
