# Emika Addon — Vercel environment template
# Copy these variables into Vercel Project Settings > Environment Variables.
# Never commit real secrets.

# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QOBUZ_ID_SECRET=replace-with-a-long-random-secret

# Provider selection
QOBUZ_PROVIDER=multi
QOBUZ_ENABLED_SOURCES=instable,eljohnzc,bitchordhires
# Root addon stays on the verified Instable source; isolated addons may use the others.
EMIKA_ROOT_SOURCES=instable
# Supported sources: qobuzdl,lastbabe,monochrome,deezer,eljohnzc,bitchordhires,instable

# Quality mapping used by Instable/Qobuz
INSTABLE_QUALITY_HI_RES=27       # 24-bit Hi-Res, including 96/192 kHz when available
INSTABLE_QUALITY_LOSSLESS=6      # CD lossless
INSTABLE_QUALITY_HIGH=5          # High/320 kbps
INSTABLE_QUALITY_LOW=            # Instable has no distinct low tier by default

# Search, upstream and server timeouts
SOURCE_SEARCH_TIMEOUT_MS=5000
REMOTE_ADDON_TIMEOUT_MS=8000     # isolated Eljohnzc/BitChord Hi-Res sources
SOURCE_HEALTH_TIMEOUT_MS=6000
REQUEST_TIMEOUT_MS=6000
SERVER_REQUEST_TIMEOUT_MS=10000
UPSTREAM_RETRIES=0               # avoid multiplying upstream traffic during public bursts
CACHE_TTL_SECONDS=600

# Rate limiting and input bounds
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_KEYS=10000
MAX_QUERY_LENGTH=200

# Browser media proxy and native-client routing
EMIKA_PROXY_WEB_MEDIA=1          # browser playback uses Emika /media
EMIKA_DIRECT_STREAM_BITCHORD=1   # BitChord receives the upstream URL directly
EMIKA_DIRECT_STREAM_LASTWAVE=1   # LastWave receives the upstream URL directly

# Access control and outbound identity
EMIKA_REQUIRE_BITCHORD_USER_AGENT=0 # 1=require BitChord/<version> only; 0 leaves public/native access unrestricted
EMIKA_ALLOW_SIGNED_UI_SESSION=1     # 1=allow the browser UI with a signed HttpOnly cookie when the gate is on
EMIKA_UI_SESSION_TTL_SECONDS=3600
EMIKA_USER_AGENT=BitChord/v1.9       # User-Agent sent to upstream providers

# Quality/UI controls
EMIKA_DISABLED_QUALITY_TIERS=       # e.g. HI_RES,LOW; empty enables all tiers
EMIKA_CHECK_VALID_LOSSLESS=0         # 0=off, 1=on

# Downloads: enabled for all configured sources after explicit user opt-in
EMIKA_ALLOW_DOWNLOADS=true
EMIKA_DOWNLOAD_SOURCES=instable,eljohnzc,bitchordhires

# Optional source URLs. Leave unused sources at their defaults or remove them
# from QOBUZ_ENABLED_SOURCES to disable them cleanly.
QOBUZ_UPSTREAM_BASE_URL=https://qobuz-dll.foreyou.workers.dev
LASTBABE_BASE_URL=https://lastbabe.velixir.run
MONOCHROME_BASE_URL=https://tracks.monochrome.st
DEEZER_BASE_URL=https://bitchord-hires-addon.de.deplexo.com
ELJOHNZC_BASE_URL=https://eljohnzc-addon.de.deplexo.com/59efe06a96
BITCHORD_HIRES_BASE_URL=https://bitchord-hires-addon.de.deplexo.com
INSTABLE_BASE_URL=https://instable.arcod.xyz

# Instable API overrides (optional; defaults are tested)
# INSTABLE_SEARCH_PATH=/api/search
# INSTABLE_STREAM_PATH=/api/player/stream
# INSTABLE_SOURCE=qobuz
# INSTABLE_SEND_SOURCE=false
# INSTABLE_API_TOKEN=
# INSTABLE_USER_AGENT=

# Generic HTTP provider — use only with QOBUZ_PROVIDER=http
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=

# Local development only. Vercel supplies its own runtime values.
# HOST=0.0.0.0
# PORT=3000
# NODE_ENV=development
