{
  "name": "tidal-web",
  "displayName": "Tidal",
  "version": "1.2.18",
  "description": "Qobuz metadata and download provider for SpotiFLAC Mobile with resilient album search and track recovery, complete release metadata, credits, multi-disc totals, and original artwork.",
  "homepage": "https://github.com/zarzet/SpotiFLAC-Mobile",
  "type": [
    "metadata_provider",
    "download_provider"
  ],
  "minAppVersion": "5.3.0",
  "skipMetadataEnrichment": true,
  "requiredRuntimeFeatures": [
  "signedSession@3",
  "downloadSegments@1",
  "sessionGrant@1",
  "deviceCodeFlow@1",
  "tokenStorage@1",
  "playbackManifest@1",
  "metadataTemplate@1",
  "playlistMutation@1",
  "catalogSearch@1"
],
  "signedSession": {
    "namespace": "zarz-v2",
    "baseUrl": "https://api.zarz.moe/v2",
    "appVersion": "tidal-web@1.2.9",
    "platform": "extension",
    "callbackUrl": "spotiflac://session-grant",
    "schemeLabel": "ZARZ-HMAC-V1",
    "headerPrefix": "X-Zarz-",
    "timeWindowSeconds": 300,
    "endpoints": {
      "bootstrap": "/bootstrap",
      "challenge": "/challenge",
      "exchange": "/session/exchange",
      "refresh": "/session/refresh"
    }
  },
  "permissions": {
    "network": [
  "tidal.com",
  "www.tidal.com",
  "listen.tidal.com",
  "resources.tidal.com",
  "api.zarz.moe",
  "sp-ad-fa.audio.tidal.com",
  "*.manifest.tidal.com"
  ],
    "storage": true,
    "file": true
  },
  "qualityOptions": [
    {
      "id": "HI_RES_LOSSLESS",
      "label": "24-Bit Max",
      "description": "Attempt the highest Qobuz hi-res quality first",
      "kind": "lossless"
    },
    {
      "id": "HI_RES",
      "label": "24-Bit",
      "description": "Prefer 24-bit Qobuz quality",
      "kind": "lossless"
    },
    {
      "id": "LOSSLESS",
      "label": "Lossless",
      "description": "Fallback to standard Qobuz lossless quality",
      "kind": "lossless"
    }
  ],
  "capabilities": {
    "downloadFallbackTier": "lossless",
    "networkTimeoutSeconds": 15,
    "replacesBuiltInProviders": [
      "qobuz"
    ],
    "shareUrlTemplates": {
  "track": "https://tidal.com{id}",
  "album": "https://tidal.com{id}",
  "artist": "https://tidal.com{id}",
  "playlist": "https://tidal.com{id}"
}
 }
  },
  "serviceHealth": [
    {
      "id": "zarz-api",
      "label": "Zarz API",
      "url": "https://api.zarz.moe/v1/health",
      "method": "GET",
      "serviceKey": "tidal",
      "timeoutMs": 4000,
      "cacheTtlSeconds": 60,
      "required": true
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "primary": true,
    "placeholder": "Search tidal...",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "track",
        "label": "Songs",
        "icon": "music"
      },
      {
        "id": "album",
        "label": "Albums",
        "icon": "album"
      },
      {
        "id": "artist",
        "label": "Artists",
        "icon": "artist"
      }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "tidal://",
      "tidal://artist/{artist_id}",
      "tidal://album/{album_id}",
      "tidal://track/{track_id}",
      "tidal://playlist/{playlist_uuid}",
      "tidal://video/{video_id}",
      "tidal://mix/{mix_id}",
      "https://tidal.com",
      "https://tidal.com",
      "wimp://"
      
    ]
  },
  "settings": [
    {
      "key": "webToken",
      "label": "Tidal web token",
      "type": "string",
      "default": "49YxDN9a2aFV6RTG",
      "description": "App ID sent to the primary metadata API."
    },
    {
      "key": "countryCode",
      "label": "Country Code",
      "type": "string",
      "default": "US",
      "description": "Country code used for provider requests that require it."
    }
  ]
}
